      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
              "pm.collectionVariables.set(\"csrfToken\", pm.response.json().data.csrfToken);"
