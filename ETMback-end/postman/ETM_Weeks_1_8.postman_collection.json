    {
      "name": "Create tournament",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tournaments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{organizerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Cup\",\n  \"slug\": \"{{cupSlug}}\",\n  \"gameId\": \"{{gameId}}\",\n  \"tournamentType\": \"SingleElimination\",\n  \"maxTeams\": 2,\n  \"minRosterSize\": 1,\n  \"maxRosterSize\": 2,\n  \"registrationOpenAt\": \"{{opensAt}}\",\n  \"registrationCloseAt\": \"{{closesAt}}\",\n  \"rosterLockAt\": \"{{rosterLockAt}}\",\n  \"startAt\": \"{{startsAt}}\",\n  \"endAt\": \"{{endsAt}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"cupSlug\", \"postman-cup-\" + Date.now());",
              "pm.collectionVariables.set(\"opensAt\", new Date(Date.now()+(-3600000)).toISOString());",
              "pm.collectionVariables.set(\"closesAt\", new Date(Date.now()+(3600000)).toISOString());",
              "pm.collectionVariables.set(\"rosterLockAt\", new Date(Date.now()+(7200000)).toISOString());",
              "pm.collectionVariables.set(\"startsAt\", new Date(Date.now()+(10800000)).toISOString());",
              "pm.collectionVariables.set(\"endsAt\", new Date(Date.now()+(14400000)).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
              "pm.collectionVariables.set(\"tournamentId\", pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
